# Generated by chezmoi from .chezmoidata/shell.toml -- edits here are lost.
{{ range $k, $v := .shell.env }}
export {{ $k }}="{{ $v }}"
{{- end }}
{{ range .shell.path }}
case ":$PATH:" in
    *":$HOME/{{ . }}:"*) ;;
    *) PATH="$HOME/{{ . }}:$PATH" ;;
esac
{{- end }}
export PATH

# Machine-local overrides, unmanaged by chezmoi. fish gets the same escape
# hatch for free: any file dropped in conf.d is sourced and left alone.
[ -f "$HOME/.config/shell/local.sh" ] && . "$HOME/.config/shell/local.sh"
