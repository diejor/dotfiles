[user]
	email = diejorarr@gmail.com
	name = Diego Rodrigues

[core]
	autocrlf = false
	# Setting this overrides git's XDG default of ~/.config/git/ignore, which
	# is why that file goes inert once this is present.
	excludesfile = ~/.gitignore_global

[alias]
	adog = log --all --decorate --oneline --graph

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
{{ if stat (joinPath .chezmoi.homeDir "projects/depot_tools") }}
# Present only where depot_tools is checked out. depot-tools writes these
# itself; mirroring them here keeps source and destination in agreement.
[depot-tools]
	useNewAuthStack = 1
{{- range list "android" "aomedia" "beto-core" "boringssl" "chromium" "dawn" "pdfium" "quiche" "skia" "swiftshader" "webrtc" }}
[credential "https://{{ . }}.googlesource.com"]
	useHttpPath = yes
	helper =
	helper = luci
{{- end }}
{{ end }}
# Machine-local overrides. git ignores this include when the file is absent.
[include]
	path = ~/.config/git/local
