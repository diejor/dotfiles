{{- $gpuGuess := "intel" -}}
{{- if lookPath "nvidia-smi" }}{{ $gpuGuess = "nvidia" }}{{ end -}}
{{- $role := promptStringOnce . "role" "role (laptop|desktop|server)" -}}
{{- $gpu := promptStringOnce . "gpu" "gpu (nvidia|intel|none)" $gpuGuess -}}

encryption = "age"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1lrplrq7psg0ua4p0etxdkjejled2kveux9l3y3syf6lt6fl093tqxxxlfa"

[git]
    # Every `chezmoi add`/`re-add` lands a commit, so work is never left untracked.
    # autoPush stays off until the remote is private.
    autoCommit = true
    autoPush = false

[data]
    role = {{ $role | quote }}
    gpu = {{ $gpu | quote }}
    gui = {{ ne $role "server" }}
    scale = {{ if eq $role "laptop" }}"1.5"{{ else }}"1.0"{{ end }}
    # Terminal font size in points; the compositor scale multiplies it, so the
    # laptop needs a smaller number to reach the same physical size.
    font_size = {{ if eq $role "laptop" }}11{{ else }}16{{ end }}
